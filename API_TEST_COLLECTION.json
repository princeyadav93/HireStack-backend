                "email": "recruiter2@hirestack.com",
                "role": "RECRUITER",
                "token": "jwt_token_recruiter_2"
            },
            "recruiter3": {
                "id": "user_003_recruiter",
                "email": "recruiter3@hirestack.com",
                "role": "RECRUITER",
                "token": "jwt_token_recruiter_3"
            },
            "candidate1": {
                "id": "user_004_candidate",
                "email": "candidate1@hirestack.com",
                "role": "CANDIDATE",
                "token": "jwt_token_candidate_1"
            },
