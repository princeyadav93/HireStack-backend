        {
            "name": "9. Delegate Billing Admin",
            "method": "POST",
            "path": "/company/{{company1_id}}/billing-admin",
            "description": "OWNER only delegates billing admin permissions to an ACTIVE ADMIN. OWNER remains immutable, but billing responsibility can be delegated.",
            "auth": {
                "type": "bearer",
                "token": "{{recruiter1_token}}"
            },
            "headers": {
                "Content-Type": "application/json"
            },
            "requestBody": {
                "adminId": "user_002_recruiter"
            },
            "expectedResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "message": "Billing admin delegated successfully",
                    "data": {
                        "_id": "company_001",
                        "name": "TechCorp Solutions",
                        "owner": "user_001_recruiter",
                        "billingAdmin": "user_002_recruiter",
                        "members": [
                            {
                                "userId": "user_001_recruiter",
                                "role": "OWNER"
                            },
                            {
                                "userId": "user_002_recruiter",
                                "role": "ADMIN"
                            }
                        ]
                    }
                }
            },
            "notes": [
                "Only OWNER can delegate billing",
                "Target must be ACTIVE ADMIN (role=ADMIN)",
                "Updates Company.billingAdmin field",
                "OWNER always accountable but can delegate to reduce bottleneck",
                "Used for billing, payment, and subscription management"
            ]
        },
