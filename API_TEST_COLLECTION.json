    "errorScenarios": [
        {
            "name": "Error: Unauthorized Access",
            "description": "User not authenticated or token invalid",
            "expectedResponse": {
                "statusCode": 401,
                "body": {
                    "success": false,
                    "message": "Unauthorized"
                }
            }
        },
        {
            "name": "Error: Forbidden - Insufficient Permissions",
            "description": "User authenticated but lacks required role",
            "endpoint": "Approve Member",
            "scenario": "Non-OWNER/ADMIN tries to approve",
            "expectedResponse": {
                "statusCode": 403,
                "body": {
                    "success": false,
                    "message": "Forbidden: Only OWNER or ADMIN can approve members"
                }
            }
        },
        {
            "name": "Error: Cannot Remove Last Owner",
            "description": "Attempting to remove or demote the last OWNER",
            "endpoint": "Remove Member or Change Role",
            "expectedResponse": {
                "statusCode": 409,
                "body": {
                    "success": false,
                    "message": "Cannot remove or demote the last OWNER of the company"
                }
            }
        },
        {
            "name": "Error: Duplicate Membership",
            "description": "User already has an ACTIVE or PENDING membership",
            "endpoint": "Join Company or Invite",
            "expectedResponse": {
                "statusCode": 409,
                "body": {
                    "success": false,
                    "message": "User already has an active or pending membership"
                }
            }
        },
        {
            "name": "Error: Recruiter Can Only Create One Company",
            "description": "Recruiter attempts to create second company",
            "endpoint": "Create Company",
            "expectedResponse": {
                "statusCode": 409,
                "body": {
                    "success": false,
                    "message": "Each recruiter can only create one company"
                }
            }
        },
        {
            "name": "Error: Invalid Member Status Transition",
            "description": "Attempting invalid status transition",
            "endpoint": "Approve non-PENDING member",
            "expectedResponse": {
                "statusCode": 400,
                "body": {
                    "success": false,
                    "message": "Cannot approve member that is not in PENDING status"
                }
            }
        }
    ],
    "workflowExamples": [
        {
            "name": "Workflow 1: Company Creation & Invitation",
            "steps": [
                "1. Recruiter1 creates company (OWNER role assigned)",
                "2. Recruiter1 invites Recruiter2 (creates PENDING membership)",
                "3. Recruiter1 approves invitation (PENDING → ACTIVE)",
                "4. Recruiter1 promotes Recruiter2 to ADMIN",
                "5. Recruiter1 delegates billing to Recruiter2",
                "6. Recruiter1 fetches members list"
            ]
        },
        {
            "name": "Workflow 2: Company Join & Approval",
            "steps": [
                "1. Company exists with OWNER Recruiter1",
                "2. Recruiter2 requests to join (creates PENDING membership)",
                "3. Recruiter1 reviews and approves (PENDING → ACTIVE)",
                "4. Recruiter2 can now see company members"
            ]
        },
        {
            "name": "Workflow 3: Member Rejection",
            "steps": [
                "1. Recruiter1 invites Recruiter3",
                "2. Recruiter1 rejects invitation with reason",
                "3. Rejection recorded with audit trail",
                "4. Recruiter3 can reapply later"
            ]
        },
        {
            "name": "Workflow 4: Member Removal",
            "steps": [
                "1. Recruiter2 is ACTIVE member",
                "2. Recruiter1 removes Recruiter2 with reason",
                "3. Status changes to REMOVED",
                "4. Recruiter2 removed from Company.members",
                "5. Audit trail preserved for compliance"
            ]
        }
    ],
    "authorizationMatrix": {
        "verifyCompanyMember": {
            "description": "User must be ACTIVE member of company",
            "appliedTo": [
                "Approve Member",
                "Reject Member",
                "Remove Member",
                "Change Role",
                "Get Members",
                "Delegate Billing"
            ]
        },
        "verifyCompanyOwner": {
            "description": "User must be OWNER role",
            "appliedTo": ["Change Role", "Delegate Billing"]
        },
        "verifyCompanyOwnerOrAdmin": {
            "description": "User must be OWNER or ADMIN role",
            "appliedTo": [
                "Invite Recruiter",
                "Approve Member",
                "Reject Member",
                "Remove Member"
            ]
        }
    },
    "denormalization": {
        "description": "Performance optimization via strategic denormalization",
        "strategy": [
            {
                "field": "Company.members",
                "purpose": "Fast query of active members without join",
                "syncedWith": "CompanyMember table (add/remove on ACTIVE/REMOVED status)",
                "tradeoff": "Extra storage, but eliminates expensive joins"
            },
            {
                "field": "RecruiterProfile.currentCompanyId",
                "purpose": "Quick lookup: which company is recruiter in?",
                "syncedWith": "CompanyMember approval/removal",
                "tradeoff": "Requires transaction consistency"
            }
        ]
    },
    "auditTrail": {
        "description": "Complete tracking of membership changes",
        "fields": [
            {
                "name": "invitedBy + invitedAt",
                "tracks": "Who invited and when (for source=INVITE)"
            },
            {
                "name": "approvedBy + approvedAt",
                "tracks": "Who approved and when"
            },
            {
                "name": "rejectedBy + rejectionReason + rejectedAt",
                "tracks": "Who rejected, why, and when"
            },
            {
                "name": "removedBy + removalReason + removedAt",
                "tracks": "Who removed, why, and when"
            },
            {
                "name": "createdAt",
                "tracks": "When membership record created (original join/invite time)"
            }
        ]
    },
    "transactionSafety": {
        "description": "All state-changing operations are transaction-safe",
        "operations": [
            {
                "name": "approveMemberService",
                "updates": [
                    "CompanyMember: PENDING → ACTIVE",
                    "Company.members: add to array",
                    "RecruiterProfile.currentCompanyId: set company ID"
                ],
                "rollback": "All changes reverted if any fails"
            },
            {
                "name": "removeMemberService",
                "updates": [
                    "CompanyMember: ACTIVE → REMOVED",
                    "Company.members: remove from array",
                    "RecruiterProfile.currentCompanyId: clear"
                ],
                "rollback": "All changes reverted if any fails"
            }
        ]
    }
}
