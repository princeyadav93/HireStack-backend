    "endpoints": [
        {
            "name": "1. Create Company",
            "method": "POST",
            "path": "/company/create",
            "description": "Only recruiters can create companies. Each recruiter can only create ONE company. Automatically creates recruiter as OWNER.",
            "auth": {
                "type": "bearer",
                "token": "{{recruiter1_token}}"
            },
            "headers": {
                "Content-Type": "application/json"
            },
            "requestBody": {
                "name": "TechCorp Solutions",
                "industry": "Software Development",
                "size": "MEDIUM",
                "description": "Leading software development company",
                "website": "https://techcorp.com",
                "location": {
                    "city": "San Francisco",
                    "state": "CA",
                    "country": "USA"
                }
            },
            "expectedResponse": {
                "statusCode": 201,
                "body": {
                    "success": true,
                    "message": "Company created successfully",
                    "data": {
                        "_id": "company_001",
                        "name": "TechCorp Solutions",
                        "industry": "Software Development",
                        "size": "MEDIUM",
                        "description": "Leading software development company",
                        "website": "https://techcorp.com",
                        "location": {
                            "city": "San Francisco",
                            "state": "CA",
                            "country": "USA"
                        },
                        "owner": "user_001_recruiter",
                        "billingAdmin": "user_001_recruiter",
                        "members": [
                            {
                                "userId": "user_001_recruiter",
                                "role": "OWNER",
                                "status": "ACTIVE"
                            }
                        ],
                        "isApproved": true,
                        "isArchived": false,
                        "createdAt": "2026-04-17T10:00:00Z"
                    }
                }
            },
            "notes": [
                "Only RECRUITER role can create company",
                "Automatically creates CompanyMember with role=OWNER, status=ACTIVE, source=CREATED",
                "Sets billingAdmin = owner",
                "Company starts as approved"
            ]
        },
        {
            "name": "2. Join Company (Request to Join)",
            "method": "POST",
            "path": "/company/join/{{company1_id}}",
            "description": "Recruiter requests to join an existing company. Creates PENDING membership with source=REQUEST.",
            "auth": {
                "type": "bearer",
                "token": "{{recruiter2_token}}"
            },
            "headers": {
                "Content-Type": "application/json"
            },
            "requestBody": {
                "invitationCode": ""
            },
            "expectedResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "message": "Successfully submitted join request",
                    "data": {
                        "_id": "member_002",
                        "userId": "user_002_recruiter",
                        "companyId": "company_001",
                        "role": "RECRUITER",
                        "status": "PENDING",
                        "source": "REQUEST",
                        "invitedBy": null,
                        "invitedAt": null,
                        "approvedBy": null,
                        "approvedAt": null,
                        "rejectedBy": null,
                        "rejectionReason": null,
                        "rejectedAt": null,
                        "removedBy": null,
                        "removalReason": null,
                        "removedAt": null,
                        "createdAt": "2026-04-17T10:05:00Z"
                    }
                }
            },
            "notes": [
                "Creates CompanyMember with status=PENDING, source=REQUEST",
                "Recruiter cannot join if they already created a company",
                "Company must be isApproved=true to allow joins",
                "Needs OWNER/ADMIN approval to become ACTIVE"
            ]
        },
        {
            "name": "3. Invite Recruiter to Company",
            "method": "POST",
            "path": "/company/{{company1_id}}/invite",
            "description": "OWNER or ADMIN invites a recruiter directly. Creates PENDING membership with source=INVITE.",
            "auth": {
                "type": "bearer",
                "token": "{{recruiter1_token}}"
            },
            "headers": {
                "Content-Type": "application/json"
            },
            "requestBody": {
                "recruiterId": "user_003_recruiter"
            },
            "expectedResponse": {
                "statusCode": 201,
                "body": {
                    "success": true,
                    "message": "Recruiter invited successfully",
                    "data": {
                        "_id": "member_003",
                        "userId": "user_003_recruiter",
                        "companyId": "company_001",
                        "role": "RECRUITER",
                        "status": "PENDING",
                        "source": "INVITE",
                        "invitedBy": "user_001_recruiter",
                        "invitedAt": "2026-04-17T10:10:00Z",
                        "approvedBy": null,
                        "approvedAt": null,
                        "rejectedBy": null,
                        "rejectionReason": null,
                        "rejectedAt": null,
                        "removedBy": null,
                        "removalReason": null,
                        "removedAt": null,
                        "createdAt": "2026-04-17T10:10:00Z"
                    }
                }
            },
            "notes": [
                "Only OWNER or ADMIN can invite",
                "Creates CompanyMember with status=PENDING, source=INVITE",
                "Tracks invitedBy and invitedAt for audit trail",
                "Invited recruiter can accept (approve) or owner can approve for them"
            ]
        },
        {
            "name": "4. Approve Membership (Request or Invite)",
            "method": "POST",
            "path": "/company/{{company1_id}}/members/approve",
            "description": "OWNER or ADMIN approves a PENDING membership request or invitation. Transitions to ACTIVE.",
            "auth": {
                "type": "bearer",
                "token": "{{recruiter1_token}}"
            },
            "headers": {
                "Content-Type": "application/json"
            },
            "requestBody": {
                "memberId": "member_002"
            },
            "expectedResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "message": "Member approved and added to company",
                    "data": {
                        "_id": "member_002",
                        "userId": "user_002_recruiter",
                        "companyId": "company_001",
                        "role": "RECRUITER",
                        "status": "ACTIVE",
                        "source": "REQUEST",
                        "invitedBy": null,
                        "approvedBy": "user_001_recruiter",
                        "approvedAt": "2026-04-17T10:20:00Z",
                        "rejectedBy": null,
                        "rejectionReason": null,
                        "rejectedAt": null,
                        "removedBy": null,
                        "removalReason": null,
                        "removedAt": null,
                        "createdAt": "2026-04-17T10:05:00Z"
                    }
                }
            },
            "notes": [
                "Only OWNER or ADMIN can approve",
                "Transitions PENDING → ACTIVE",
                "Updates approvedBy and approvedAt (audit trail)",
                "Adds member to Company.members denormalized array",
                "Updates RecruiterProfile.currentCompanyId (denormalization)"
            ]
        },
        {
            "name": "5. Reject Membership (Request or Invite)",
            "method": "POST",
            "path": "/company/{{company1_id}}/members/reject",
            "description": "OWNER or ADMIN rejects a PENDING membership. Sets status=REJECTED with reason.",
            "auth": {
                "type": "bearer",
                "token": "{{recruiter1_token}}"
            },
            "headers": {
                "Content-Type": "application/json"
            },
            "requestBody": {
                "memberId": "member_003",
                "reason": "Qualifications do not match current requirements"
            },
            "expectedResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "message": "Member application rejected",
                    "data": {
                        "_id": "member_003",
                        "userId": "user_003_recruiter",
                        "companyId": "company_001",
                        "role": "RECRUITER",
                        "status": "REJECTED",
                        "source": "INVITE",
                        "invitedBy": "user_001_recruiter",
                        "invitedAt": "2026-04-17T10:10:00Z",
                        "approvedBy": null,
                        "approvedAt": null,
                        "rejectedBy": "user_001_recruiter",
                        "rejectionReason": "Qualifications do not match current requirements",
                        "rejectedAt": "2026-04-17T10:25:00Z",
                        "removedBy": null,
                        "removalReason": null,
                        "removedAt": null,
                        "createdAt": "2026-04-17T10:10:00Z"
                    }
                }
            },
            "notes": [
                "Only OWNER or ADMIN can reject",
                "Transitions PENDING → REJECTED",
                "Captures rejectedBy, rejectionReason, rejectedAt (full audit trail)",
                "Soft delete: record preserved for audit purposes",
                "User can reapply later if rejected"
            ]
        },
        {
            "name": "6. Remove Member from Company",
            "method": "POST",
            "path": "/company/{{company1_id}}/members/remove",
            "description": "OWNER or ADMIN removes an ACTIVE member from company. Sets status=REMOVED with reason.",
            "auth": {
                "type": "bearer",
                "token": "{{recruiter1_token}}"
            },
            "headers": {
                "Content-Type": "application/json"
            },
            "requestBody": {
                "memberId": "member_002",
                "reason": "Performance issues and team mismatch"
            },
            "expectedResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "message": "Member removed from company",
                    "data": {
                        "_id": "member_002",
                        "userId": "user_002_recruiter",
                        "companyId": "company_001",
                        "role": "RECRUITER",
                        "status": "REMOVED",
                        "source": "REQUEST",
                        "invitedBy": null,
                        "approvedBy": "user_001_recruiter",
                        "approvedAt": "2026-04-17T10:20:00Z",
                        "rejectedBy": null,
                        "rejectionReason": null,
                        "rejectedAt": null,
                        "removedBy": "user_001_recruiter",
                        "removalReason": "Performance issues and team mismatch",
                        "removedAt": "2026-04-17T10:30:00Z",
                        "createdAt": "2026-04-17T10:05:00Z"
                    }
                }
            },
            "notes": [
                "Only OWNER or ADMIN can remove",
                "Transitions ACTIVE → REMOVED",
                "Cannot remove last OWNER (edge case protection)",
                "Captures removedBy, removalReason, removedAt (full audit trail)",
                "Soft delete: record preserved, removed from Company.members array",
                "RecruiterProfile.currentCompanyId cleared"
            ]
        },
        {
            "name": "7. Change Member Role",
            "method": "PUT",
            "path": "/company/{{company1_id}}/members/role",
            "description": "OWNER only changes member role. Can promote RECRUITER to ADMIN or demote ADMIN to RECRUITER. Cannot change OWNER role.",
            "auth": {
                "type": "bearer",
                "token": "{{recruiter1_token}}"
            },
            "headers": {
                "Content-Type": "application/json"
            },
            "requestBody": {
                "memberId": "member_002",
                "newRole": "ADMIN"
            },
            "expectedResponse": {
                "statusCode": 200,
                "body": {
                    "success": true,
                    "message": "Member role updated",
                    "data": {
                        "_id": "member_002",
                        "userId": "user_002_recruiter",
                        "companyId": "company_001",
                        "role": "ADMIN",
                        "status": "ACTIVE",
                        "source": "REQUEST",
                        "invitedBy": null,
                        "approvedBy": "user_001_recruiter",
                        "approvedAt": "2026-04-17T10:20:00Z",
                        "rejectedBy": null,
                        "rejectionReason": null,
                        "rejectedAt": null,
                        "removedBy": null,
                        "removalReason": null,
                        "removedAt": null,
                        "createdAt": "2026-04-17T10:05:00Z"
                    }
                }
            },
            "notes": [
                "Only OWNER can change roles",
                "Cannot demote last OWNER (edge case protection)",
                "Allowed transitions:",
                "  - RECRUITER → ADMIN (promotion)",
                "  - ADMIN → RECRUITER (demotion)",
                "  - OWNER stays OWNER (immutable for billing accountability)",
                "Transaction-safe: updates CompanyMember + Company.members"
            ]
        },
