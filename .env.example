# ==========================================
# HireStack Backend - Environment Variables
# ==========================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to version control!

# ==========================================
# Server Configuration
# ==========================================
# Server port (default: 3000)
PORT=3000

# Node environment (development, staging, production)
NODE_ENV=development

# How many proxy hops sit between the internet and this app.
#   1  Render / Railway / Fly / nginx on its own          (the default)
#   2  a Vercel rewrite proxying /api/* through to Render (see README)
#   3  Cloudflare in front of that
#
# Rate limiting keys on the client IP, and this is what decides which address
# in X-Forwarded-For is treated as the client. Too low and every user shares
# one bucket — the 5-per-hour email limiter becomes 5 per hour for the whole
# platform. Nothing errors when it is wrong, so check it after deploying:
# every request log line carries an `ip` field, so call the API from a known
# address and see whether that address is what gets logged.
#
# Must be a whole number. NOT `true` — that trusts the entire caller-supplied
# header chain, letting anyone forge an IP and skip the limiters. The app
# refuses to boot on a non-integer for exactly that reason.
TRUST_PROXY=1

# Log verbosity: fatal, error, warn, info, debug, trace, silent.
# Leave blank and it picks itself: debug locally, info in production, silent in
# tests. Set it explicitly to turn debug on for a live instance while chasing
# something, then unset it — debug logs every request body-sized detail and log
# storage is the thing free tiers run out of first.
LOG_LEVEL=

# ==========================================
# Database Configuration
# ==========================================
# MongoDB connection string
# Format: mongodb://username:password@host:port/database
# Example: mongodb+srv://user:pass@cluster.mongodb.net/hirestack
MONGODB_URI=mongodb://localhost:27017/hirestack

# ==========================================
# Authentication & Security
# ==========================================
# JWT secret key for token signing (use a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Refresh token secret. Use a DIFFERENT value from JWT_SECRET so the two token
# types cannot be signed interchangeably. If unset it falls back to JWT_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this_in_production

# Refresh token expiry duration (format: 7d, 30d, 1h, etc.)
REFRESH_TOKEN_EXPIRY=10d

# Bcrypt salt rounds for password hashing (10-12 recommended for security)
SALTROUNDS=10

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of origins allowed to call this API with cookies.
# There is no wildcard: credentialed requests require an explicit origin, and
# any origin not listed here is rejected with 403.
#
# In production the frontend is expected to proxy /api/* through to this service
# so the browser only ever sees one origin (see "Deployment notes" in
# README.md). Calls arriving that way are same-origin and never consult this
# list — it covers direct callers: local dev, Postman, other services.
# Example: CORS_ORIGIN=http://localhost:5173,https://app.hirestack.com
CORS_ORIGIN=http://localhost:5173

# ==========================================
# Cloudinary Configuration (File Upload Service)
# ==========================================
# Cloudinary cloud name
# Get from: https://cloudinary.com/console
CLOUDINARY_NAME=your_cloudinary_name

# Cloudinary API key
# Get from: https://cloudinary.com/console
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API secret
# Get from: https://cloudinary.com/console
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# Email (verification and password reset)
# ==========================================
# Where the links inside emails point. This is the FRONTEND, not this API — a
# reset link has to open a page with a password form on it. The frontend reads
# ?token=... and posts it back to /auth/reset-password or /auth/verify-email.
APP_URL=http://localhost:5173

# The From: header on outgoing mail.
EMAIL_FROM=HireStack <no-reply@hirestack.local>

# SMTP. Leave SMTP_HOST BLANK and emails are printed to the server console
# instead of being sent — enough to develop and test the whole flow without a
# provider account. Set it and mail goes out for real.
#
# Any provider works, they all speak SMTP. Some hosts to save you a search:
#   Resend    smtp.resend.com        port 587   user: resend       pass: API key
#   SendGrid  smtp.sendgrid.net      port 587   user: apikey       pass: API key
#   Mailgun   smtp.mailgun.org       port 587   user/pass from the Mailgun UI
#   Mailtrap  sandbox.smtp.mailtrap.io port 2525  (catches mail, sends nothing)
#   Gmail     smtp.gmail.com         port 587   requires an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Implicit TLS. Leave false on port 587 (STARTTLS is negotiated automatically);
# set true only for port 465.
SMTP_SECURE=false

# ==========================================
# First Platform Admin (seed script only)
# ==========================================
# POST /admin/register requires an existing admin, so the first one is created
# with: npm run seed:admin
# Either set these, or pass --name / --email / --password on the command line.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password
